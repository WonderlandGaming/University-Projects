package javaapplication39.pkg00;

import java.util.Scanner;

public class JavaApplication3900 {

    
    public static double cylinderVolume(double dValue, double hValue) {
        double radius = dValue / 2.0; 
        double volume = Math.PI * Math.pow(radius, 2) * hValue; 
        return volume;
    }

    public static void main(String[] args) {
        Scanner input = new Scanner(System.in);

        System.out.print("Enter the diameter of the cylinder: ");
        double diameter = input.nextDouble();

        System.out.print("Enter the height of the cylinder: ");
        double height = input.nextDouble();

        
        double result = cylinderVolume(diameter, height);

        System.out.println("The volume of the cylinder is: " + result);

        input.close();
    }
}



