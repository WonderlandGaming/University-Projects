public class EmailApp {

    // The required static method
    public static String extractDomain(String email) {
        // Step 1: Trim whitespace
        email = email.trim();

        // Step 2: Locate the '@' symbol
        int atIndex = email.indexOf('@');
        
        // If '@' is missing, return "Invalid Email"
        if (atIndex == -1) {
            return "Invalid Email";
        }

        // Step 3: Extract everything after '@' and convert to lowercase
        String domain = email.substring(atIndex + 1);
        return domain.toLowerCase();
    }

    public static void main(String[] args) {
        // Test case from your sheet
        String testEmail = "  20252007@fue.edu  ";
        
        String result = extractDomain(testEmail);
        
        System.out.println("Input: \"" + testEmail + "\"");
        System.out.println("Output: " + result);
    }
}
